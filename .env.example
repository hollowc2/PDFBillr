# PDFBillr environment variables. Copy to .env and fill in values.
# Never commit .env to version control.

APP_ENV=development

# REQUIRED — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Canonical external origin, including any path prefix. Required in production.
PUBLIC_BASE_URL=http://localhost:8000

# Leave false when Gunicorn is reachable directly. Enable only when a trusted
# reverse proxy is the sole route to Gunicorn.
TRUST_PROXY_HEADERS=false
TRUSTED_HOSTS=localhost,127.0.0.1

# Database (optional — defaults to SQLite at instance/pdfbillr.db).
# SQLite is the currently verified database. The Psycopg 3 driver is installed,
# but PostgreSQL is not yet covered by integration and concurrency tests.
DATABASE_URL=sqlite:///pdfbillr.db

# OPTIONAL — IPs gunicorn trusts for X-Forwarded-* headers (default: 127.0.0.1)
# If using nginx/Traefik in Docker Compose, set to the Docker bridge subnet e.g. 172.16.0.0/12
FORWARDED_ALLOW_IPS=127.0.0.1
# Production requires a shared backend. The runtime includes the Redis client;
# use a separately operated Redis endpoint rather than an in-container cache.
RATELIMIT_STORAGE_URI=memory://
# More than one worker also requires PostgreSQL and concurrency testing; SQLite
# deployments should leave this at one.
WEB_CONCURRENCY=1
SESSION_COOKIE_SECURE=false
ENABLE_HSTS=false
DISABLE_SCHEDULER=true
SCHEDULER_TIMEZONE=UTC
# Development/test convenience. Production should run `flask --app app db-bootstrap`
# once during deployment and leave this false.
AUTO_CREATE_DB=true
UPLOAD_FOLDER=/app/instance/uploads
MAX_LOGO_PIXELS=10000000
MAX_LOGO_DIMENSION=4096

# Stripe — get keys from https://dashboard.stripe.com/apikeys
# Use sk_test_... / pk_test_... for development, sk_live_... / pk_live_... for production
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Webhook secret — from `stripe listen` CLI or the Stripe dashboard webhook endpoint
STRIPE_WEBHOOK_SECRET=whsec_...
# Price ID for the Pro monthly plan — create in Stripe dashboard under Products
STRIPE_PRICE_ID_PRO=price_...

# Flask-Mail (SMTP) — used for welcome, password reset, and invoice emails
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=you@example.com
MAIL_PASSWORD=yourpassword
MAIL_DEFAULT_SENDER=noreply@pdfbillr.com
